# ─── Local development ───────────────────────────────────────────
# Copy this file to `.env` and fill in your local Postgres credentials.
# In production (Render), set DATABASE_URL instead and leave these blank.

PORT=5000

# Local Postgres (used when DATABASE_URL is not set)
DB_USER=postgres
DB_HOST=127.0.0.1
DB_NAME=lifedesk_db
DB_PASSWORD=your_local_password
DB_PORT=5432

# ─── Production (Render / Railway / Neon) ────────────────────────
# A single connection string. When present, it takes priority over the
# individual DB_* vars above and enables SSL automatically (see db.js).
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Auth
JWT_SECRET=change_me_to_a_long_random_string

# Optional — password-reset email (app runs fine without these)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=
# CLIENT_URL=
